---
import "../styles/global.css";
import { siteData } from "../data/site";

interface Props {
  readonly title?: string;
  readonly description?: string;
}

const {
  title = siteData.seo.title,
  description = siteData.seo.description,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string): string => `${base}${path.replace(/^\//, "")}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HVACBusiness",
      "@id": "https://studiotche.github.io/Instalacao-ar-condicionado-am-climatizar/#business",
      "name": "AM Climatizar",
      "legalName": "AM Climatizar — Climatização e Elétrica Residencial",
      "url": siteData.seo.canonicalUrl,
      "logo": asset(siteData.seo.ogImage),
      "image": asset(siteData.hero.image.url),
      "description": "Mais de 4 anos de experiência em instalação, manutenção, higienização de ar-condicionado, carga de gás, capacitor e elétrica residencial em Ivoti e região.",
      "telephone": "+5551997736690",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "R. Santa Rita, 282",
        "addressLocality": "Ivoti",
        "addressRegion": "RS",
        "postalCode": "93900-000",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -29.6057596,
        "longitude": -51.1560729
      },
      "areaServed": [
        { "@type": "City", "name": "Ivoti" },
        { "@type": "City", "name": "Dois Irmãos" },
        { "@type": "City", "name": "Estância Velha" },
        { "@type": "City", "name": "Novo Hamburgo" },
        { "@type": "AdministrativeArea", "name": "Vale dos Sinos e Encosta da Serra - RS" }
      ],
      "priceRange": "$$",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços de Climatização e Elétrica AM Climatizar",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Instalação de Ar-Condicionado em Ivoti",
              "description": "Instalação Split e Inverter com tubulação em cobre, vácuo com vacuômetro e acabamento alinhado."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Higienização Preventiva e Limpeza Química",
              "description": "Higienização com máquina pressurizada e bactericida especial contra ácaros, fungos e odores."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Carga de Gás e Troca de Capacitor",
              "description": "Medição de pressão com manifold digital, reposição de fluido refrigerante e teste de capacitor."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Elétrica Residencial Especializada",
              "description": "Instalação de circuitos dedicados, disjuntores e tomadas para ar-condicionado com total segurança."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://studiotche.github.io/Instalacao-ar-condicionado-am-climatizar/#faq",
      "mainEntity": siteData.faq.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags Oficiais -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={siteData.seo.keywords} />
    <meta name="author" content="AM Climatizar" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={siteData.seo.canonicalUrl} />
    <meta name="geo.region" content="BR-RS" />
    <meta name="geo.placename" content="Ivoti" />

    <!-- OpenGraph / Social Meta -->
    <meta property="og:site_name" content="AM Climatizar" />
    <meta property="og:type" content="business.business" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteData.seo.canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={asset(siteData.seo.ogImage)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={asset(siteData.seo.ogImage)} />

    <!-- Favicon Oficial AM Climatizar -->
    <link rel="icon" type="image/x-icon" href={asset("/favicon.ico")} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset("/favicon.png")} />
    <link rel="icon" type="image/webp" href={asset("/favicon.webp")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("/apple-touch-icon.png")} />

    <!-- Preload da Imagem Principal do Hero (LCP Optimization) -->
    <link rel="preload" as="image" href={asset(siteData.hero.image.url)} fetchpriority="high" />

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD Structured Data: LocalBusiness, Services & FAQPage -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>
  <body class="bg-[#FBFBFB] text-[#0F141C] antialiased selection:bg-[#0C3B78] selection:text-white flex flex-col min-h-screen">
    <slot />
    <script src="../scripts/site-interactions.ts"></script>
    <script src="../scripts/smooth-scroll.ts"></script>
  </body>
</html>
