---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string): string => `${base}${path.replace(/^\//, "")}`;
---
<BaseLayout>
  <!-- A11y Skip Link -->
  <a href="#conteudo-principal" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#0C3B78] focus:text-white focus:rounded-md focus:shadow-md">
    Pular para o conteúdo principal
  </a>

  <!-- Application Mount Target -->
  <div id="app" class="flex flex-col min-h-screen">
        <!-- Main Header (Fixo com Alto Desempenho) -->
    <header id="main-header" class="site-header header-blue header-fixed py-2.5 sm:py-3">
      <div class="max-w-7xl mx-auto px-5 max-[375px]:px-4 sm:px-8 flex items-center justify-between">
        <!-- Logo (Clean, Borderless, Enlarged, Without Written Text) -->
        <a href="#" class="flex items-center focus:outline-none group py-0.5" aria-label={`${siteData.company.name} - Início`}>
          <img 
            src={asset("/assets/images/logo-am-climatizar.webp")} 
            alt={siteData.company.name} 
            class="header-brand-logo" 
            width="176" 
            height="58" 
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="header-desktop-nav" aria-label="Navegação Principal">
          {siteData.navigation.map((item) => (
            <a href={item.href} class="header-nav-link">
              {item.label}
            </a>
          ))}
        </nav>

        <!-- CTA & Mobile Menu Toggle -->
        <div class="flex items-center gap-3 sm:gap-4">
          <a href={`https://wa.me/${siteData.company.whatsappRaw}?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento%20com%20a%20AM%20Climatizar.`} target="_blank" rel="noopener noreferrer" class="header-cta-btn !hidden sm:!inline-flex shadow-xs">
            <span>Solicitar orçamento</span>
            <svg class="btn-icon-arrow w-3.5 h-3.5 text-[#0C3B78]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <button id="mobile-menu-toggle" type="button" class="lg:hidden p-2 text-slate-200 hover:text-white hover:bg-white/10 focus:outline-none rounded-md transition-colors" aria-label="Abrir menu de navegação" aria-expanded="false">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-backdrop" class="fixed inset-0 bg-slate-950/70 z-50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>
    <div id="mobile-drawer" class="mobile-drawer-blue fixed inset-y-0 right-0 max-w-sm w-full text-white z-50 pt-2.5 px-5 pb-6 max-[375px]:px-4 shadow-2xl transform translate-x-full invisible transition-transform duration-300 ease-out flex flex-col justify-between lg:hidden border-l border-white/10">
      <div>
        <div class="flex items-center justify-between pb-3 sm:pb-4 border-b border-white/10">
          <a href="#" class="flex items-center focus:outline-none group py-0.5" aria-label={`${siteData.company.name} - Início`}>
            <img 
              src={asset("/assets/images/logo-am-climatizar.webp")} 
              alt={siteData.company.name} 
              class="header-brand-logo" 
              width="176" 
              height="58" 
            />
          </a>
          <button id="mobile-menu-close" type="button" class="p-2 text-slate-200 hover:text-white hover:bg-white/10 transition-colors focus:outline-none rounded-md mr-[-8px] sm:mr-0" aria-label="Fechar menu">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="mt-8 flex flex-col gap-2" aria-label="Navegação móvel">
          {siteData.navigation.map((item) => (
            <a href={item.href} class="mobile-nav-link block w-full text-center text-base font-semibold text-slate-100 hover:text-[#00B4FF] py-2.5 transition-colors">
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <div class="pt-6 border-t border-white/10 flex flex-col gap-3">
        <a href={`https://wa.me/${siteData.company.whatsappRaw}?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento%20com%20a%20AM%20Climatizar.`} target="_blank" rel="noopener noreferrer" class="header-cta-btn w-full justify-center !h-12 !text-sm">
          <span>Solicitar orçamento</span>
          <svg class="btn-icon-arrow w-4 h-4 text-[#0C3B78]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <p class="text-xs text-center text-slate-400 mt-1">{siteData.company.locationString}</p>
      </div>
    </div>

    <!-- Conteúdo Principal -->
    <main id="conteudo-principal">
      
      <!-- Hero Section (Pedro Zvir Height Parity & Design Principles) -->
      <section class="hero-section" aria-labelledby="hero-title">
        <!-- Imagem de Fundo Integrada (Largura Total) -->
        <div class="hero-bg-desktop">
          <picture class="w-full h-full block">
            <source media="(max-width: 1023px)" srcset={asset(siteData.hero.imageMobile.url)} />
            <img 
              src={asset(siteData.hero.image.url)} 
              alt={siteData.hero.image.alt} 
              loading="eager"
              fetchpriority="high"
              width={siteData.hero.image.width}
              height={siteData.hero.image.height}
            />
          </picture>
        </div>

        <div class="hero-container">
          <div class="grid grid-cols-1 lg:grid-cols-2 items-center">

            <div class="hero-copy-container flex flex-col items-start justify-center py-2 sm:py-4 lg:py-6 z-10">
              <span class="hero-animate-up text-[12px] sm:text-[13px] font-bold uppercase tracking-[0.08em] text-[#0C3B78] block mb-3 sm:mb-4">
                {siteData.hero.eyebrow}
              </span>

              <h1 id="hero-title" class="hero-animate-up hero-delay-80 hero-heading-display mb-4 sm:mb-5">
                {siteData.hero.headlinePart1}<br class="hidden min-[390px]:inline" /> {siteData.hero.headlinePart2}<br />
                <span class="text-[#0090D0]">{siteData.hero.headlineHighlight}</span>
              </h1>

              <p class="hero-animate-up hero-delay-160 font-body text-[15px] sm:text-[16px] text-slate-600 leading-[1.65] max-w-[500px] mb-6 sm:mb-8">
                {siteData.hero.description}
              </p>

              <div class="hero-animate-up hero-delay-240 hero-actions flex flex-col min-[390px]:flex-row items-stretch min-[390px]:items-center gap-3.5 sm:gap-5 w-full sm:w-auto mb-6 sm:mb-8">
                <a href={`https://wa.me/${siteData.company.whatsappRaw}?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento%20com%20a%20AM%20Climatizar.`} target="_blank" rel="noopener noreferrer" class="btn-primary !h-[50px] !px-7 sm:!px-8 !rounded-lg !text-[15px] font-semibold shadow-sm hover:shadow-md hover:-translate-y-[1px] transition-all duration-200 justify-center">
                  <span>{siteData.hero.primaryCta}</span>
                  <svg class="btn-icon-arrow w-4 h-4 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                
                <a href="#servicos" class="link-editorial whitespace-nowrap group inline-flex items-center justify-center gap-2 py-2.5 px-3 text-[#0C3B78] hover:text-[#0090D0] font-semibold text-[15px] transition-colors duration-200">
                  <span>{siteData.hero.secondaryCta}</span>
                  <svg class="w-4 h-4 text-[#0090D0] transform transition-transform duration-200 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
              </div>

              <div class="hero-animate-up hero-delay-320 inline-flex items-start sm:items-center gap-2.5 px-3.5 py-2.5 rounded-lg bg-slate-50 border border-slate-200/90 text-xs sm:text-[13px] text-slate-700 font-medium shadow-2xs w-full sm:w-auto">
                <svg class="w-3.5 h-3.5 text-[#0C3B78] shrink-0 mt-0.5 sm:mt-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <div class="flex flex-col sm:flex-row sm:items-center gap-0.5 sm:gap-1.5 leading-snug">
                  <span>Atendimento em <span class="text-[#0090D0] font-semibold">{siteData.company.city}/{siteData.company.state}</span></span>
                  <span class="hidden sm:inline text-slate-300">|</span>
                  <span class="text-slate-500 sm:text-slate-700">Atendimento em toda a região</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- Trust Bar -->
      <section class="bg-slate-50/80 border-y border-slate-200/75" aria-label="Diferenciais e Padrão de Atendimento">
        <div class="reveal-fade max-w-[1280px] mx-auto px-5 max-[375px]:px-4 sm:px-8 py-5 sm:py-6 lg:py-7">
          <div class="grid grid-cols-1 min-[370px]:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-0 lg:divide-x lg:divide-slate-200/80">
            
            {siteData.trustBar.map((item, index) => (
              <div class={`flex flex-col sm:flex-row items-start sm:items-center gap-2.5 sm:gap-3.5 group py-1.5 sm:py-2 ${index === 0 ? "lg:pr-4 xl:pr-6" : index === 3 ? "lg:pl-4 xl:pl-6" : "lg:px-4 xl:px-6"}`}>
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-blue-50/90 border border-blue-100/70 flex items-center justify-center shrink-0 transition-all duration-200 group-hover:bg-blue-100/80 group-hover:border-blue-200/90 shadow-2xs">
                  {item.icon === "tool" && (
                    <svg class="w-5 h-5 text-[#0090D0]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                  )}
                  {item.icon === "gear" && (
                    <svg class="w-5 h-5 text-[#0090D0]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                  )}
                  {item.icon === "team" && (
                    <svg class="w-5 h-5 text-[#0090D0]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                      <circle cx="9" cy="7" r="4"/>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                  )}
                  {item.icon === "location" && (
                    <svg class="w-5 h-5 text-[#0090D0]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  )}
                </div>
                <div class="min-w-0">
                  <h3 class="text-[13px] min-[390px]:text-[13.5px] sm:text-[14px] xl:text-[14.5px] font-bold text-slate-900 leading-tight tracking-tight lg:whitespace-nowrap">
                    {item.title}
                  </h3>
                  <p class="text-[11.5px] sm:text-[12px] xl:text-[12.5px] text-slate-500 leading-snug mt-0.5 sm:mt-1">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}

          </div>
        </div>
      </section>

      <!-- Serviços -->
      <section id="servicos" class="py-16 sm:py-20 lg:py-28" aria-labelledby="servicos-title">
        <div class="max-w-7xl mx-auto px-5 max-[375px]:px-4 sm:px-8">
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
            
            <!-- Coluna Esquerda -->
            <div class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col">
              <span class="reveal-up text-xs font-semibold uppercase tracking-wider text-[#0C3B78] block mb-2 sm:mb-3">{siteData.services.eyebrow}</span>
              <h2 id="servicos-title" class="reveal-up font-display text-[30px] min-[390px]:text-[32px] sm:text-[clamp(36px,4vw,48px)] font-bold text-[#0F141C] tracking-tight leading-[1.1] mb-4 sm:mb-5" style="transition-delay: 80ms;">
                {siteData.services.title}
              </h2>
              <p class="reveal-up text-[15px] sm:text-base text-slate-600 leading-relaxed mb-6 lg:mb-10" style="transition-delay: 140ms;">
                {siteData.services.description}
              </p>

              <!-- Fotografia Técnica Integrada (Desktop) -->
              <div class="reveal-scale hidden lg:block rounded-lg overflow-hidden border border-slate-200 bg-slate-100 aspect-[4/5] sm:aspect-[3/4] shadow-md relative" style="transition-delay: 180ms;">
                <img 
                  id="service-featured-img"
                  src={asset(siteData.services.items[0].image)} 
                  alt={siteData.services.items[0].alt} 
                  class="w-full h-full object-cover transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] transform scale-100"
                  loading="lazy"
                  width="440"
                  height="586"
                />
              </div>
            </div>

            <!-- Lado Direito Desktop -->
            <div class="hidden lg:block lg:col-span-8 border-t border-slate-300/80">
              {siteData.services.items.map((svc, idx) => (
                <article class="reveal-up service-item group py-7 sm:py-8 border-b border-slate-300/80 transition-colors duration-300 hover:bg-slate-50 px-2 sm:px-4 rounded-md" data-service-img={asset(svc.image)} style={`transition-delay: ${idx * 60}ms;`}>
                  <div class="flex items-start justify-between gap-4 sm:gap-6 cursor-pointer" data-service-trigger>
                    
                    <div class="flex items-start gap-4 sm:gap-8">
                      <span class="text-[13px] font-mono font-semibold text-[#0090D0] pt-1.5 shrink-0 opacity-80">{svc.number}</span>
                      <div>
                        <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 mb-2 sm:mb-1">
                          <h3 class="font-display text-xl sm:text-2xl font-bold text-slate-800 group-hover:text-[#0C3B78] transition-colors duration-300">
                            {svc.title}
                          </h3>
                          <span class="text-[11px] font-semibold tracking-wide text-slate-400 font-mono uppercase">{svc.tag}</span>
                        </div>
                        <p class="text-[15px] sm:text-base text-slate-600 leading-relaxed max-w-xl">
                          {svc.description}
                        </p>
                      </div>
                    </div>

                    <div class="flex items-center shrink-0 self-center">
                      <a href={`https://wa.me/${siteData.company.whatsappRaw}?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento%20para%20${encodeURIComponent(svc.title)}.`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 group-hover:border-[#0C3B78] group-hover:text-white group-hover:bg-[#0C3B78] transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]" aria-label={`Orçar ${svc.title}`}>
                        <svg class="w-4 h-4 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-[3px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                      </a>
                    </div>

                  </div>
                </article>
              ))}
            </div>

            <!-- Lado Mobile: Accordion Limpo -->
            <div class="block lg:hidden border-t border-slate-200">
              {siteData.services.items.map((svc, idx) => (
                <details class="group/acc border-b border-slate-200 py-2.5" open={idx === 0}>
                  <summary class="flex items-center justify-between gap-4 py-2 min-h-[48px] cursor-pointer select-none">
                    <div class="flex items-center gap-3">
                      <span class="text-xs font-mono font-bold text-[#0090D0]">{svc.number}</span>
                      <h3 class="font-display text-[16px] min-[390px]:text-[17px] font-bold text-slate-800 group-open/acc:text-[#0C3B78] transition-colors leading-snug">
                        {svc.title}
                      </h3>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 group-open/acc:bg-[#0C3B78] group-open/acc:text-white transition-all shrink-0">
                      <svg class="w-4 h-4 transform transition-transform duration-200 group-open/acc:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </summary>
                  
                  <div class="pt-2 pb-3.5 pl-6 sm:pl-7 pr-1 space-y-3">
                    <div>
                      <span class="inline-block text-[11px] font-mono font-bold tracking-wider uppercase text-[#0C3B78] bg-blue-50/80 px-2.5 py-0.5 rounded">
                        {svc.tag}
                      </span>
                    </div>
                    
                    <p class="text-[15px] text-slate-600 leading-relaxed">
                      {svc.description}
                    </p>

                    <div class="rounded-lg overflow-hidden aspect-[4/5] border border-slate-200 shadow-xs w-full max-w-[320px] sm:max-w-sm mt-2">
                      <img 
                        src={asset(svc.image)} 
                        alt={svc.alt} 
                        class="w-full h-full object-cover object-top"
                        loading="lazy"
                        width="400"
                        height="500"
                      />
                    </div>

                    <div class="pt-1.5">
                      <a href={`https://wa.me/${siteData.company.whatsappRaw}?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento%20para%20${encodeURIComponent(svc.title)}.`} target="_blank" rel="noopener noreferrer" class="btn-primary !h-11 !px-5 !text-xs w-full sm:w-auto justify-center">
                        <span>Solicitar orçamento</span>
                        <svg class="btn-icon-arrow w-3.5 h-3.5 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                      </a>
                    </div>
                  </div>
                </details>
              ))}
            </div>

          </div>

        </div>
      </section>

      <!-- Padrão de Instalação (Dark Editorial) -->
      <section id="instalacao" class="bg-[#0c111a] py-16 sm:py-20 lg:py-28" aria-labelledby="install-title">
        <div class="max-w-7xl mx-auto px-5 max-[375px]:px-4 sm:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-center">
            
            <div class="reveal-scale order-1 lg:order-1 relative rounded-lg overflow-hidden border border-slate-800 shadow-xl aspect-[4/5] max-h-[520px] sm:max-h-[560px] mx-auto w-full max-w-md lg:max-w-none">
              <img 
                src={asset(siteData.installation.image.url)} 
                alt={siteData.installation.image.alt} 
                class="w-full h-full object-cover object-top"
                loading="lazy"
                width={siteData.installation.image.width}
                height={siteData.installation.image.height}
              />
            </div>

            <div class="order-2 lg:order-2 flex flex-col">
              <h2 id="install-title" class="reveal-up font-display text-[30px] min-[390px]:text-[32px] sm:text-[clamp(36px,4vw,48px)] font-bold text-white tracking-tight leading-[1.1] mb-4 sm:mb-5">
                {siteData.installation.headline}
              </h2>
              <p class="reveal-up text-[15px] sm:text-base text-slate-300 leading-relaxed mb-8 sm:mb-10 max-w-xl" style="transition-delay: 80ms;">
                {siteData.installation.text}
              </p>
              
              <div class="grid grid-cols-1 min-[420px]:grid-cols-2 gap-x-6 gap-y-7 sm:gap-x-8 sm:gap-y-10">
                {siteData.installation.pillars.map((pillar, idx) => (
