---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutBenefits, faqs, processSteps, reviews, services, site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const whatsapp = (subject: string) => `${site.phoneLink}%20Sobre%20${encodeURIComponent(subject)}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.seo.description,
  url: site.seo.url,
  image: `${site.seo.url}${site.seo.ogImage}`,
  telephone: "+5551999199846",
  sameAs: [site.googleProfile, site.instagram],
  address: { "@type": "PostalAddress", streetAddress: "Av. Pres. Lucena, 2084", addressLocality: site.city, addressRegion: site.state, postalCode: site.postalCode, addressCountry: "BR" },
  geo: { "@type": "GeoCoordinates", latitude: -29.6055194, longitude: -51.1627442 },
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.6", bestRating: "5" },
};
---
<BaseLayout>
  <Fragment slot="head">
    <link rel="preload" as="image" href={asset(site.assets.hero)} fetchpriority="high" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
  <header class="site-header" id="siteHeader">
    <div class="container header-container">
      <a href="#inicio" class="header-logo" aria-label="Lavanderia Ivoti - Página inicial">
        <img src={asset(site.assets.logo)} alt="Lavanderia Ivoti" width="1024" height="1536" fetchpriority="high" />
      </a>
      <nav class="site-nav" aria-label="Navegação principal">
        <ul class="nav-list"><li><a href="#inicio" class="nav-link active">Início</a></li><li><a href="#servicos" class="nav-link">Serviços</a></li><li><a href="#sobre" class="nav-link">Sobre</a></li><li><a href="#avaliacoes" class="nav-link">Avaliações</a></li><li><a href="#contato" class="nav-link">Contato</a></li></ul>
      </nav>
      <div class="header-actions"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-header-whatsapp"><svg class="icon-whatsapp" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/><path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/></svg><span>WhatsApp {site.phoneDisplay}</span></a></div>
      <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Abrir menu de navegação" aria-expanded="false" aria-controls="mobileDrawer"><span></span><span></span><span></span></button>
    </div>
    <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true"><div class="mobile-drawer-panel"><button class="mobile-close" type="button" data-close-menu aria-label="Fechar menu">×</button><div class="mobile-drawer-brand"><img src={asset(site.assets.logo)} alt="Lavanderia Ivoti" width="1024" height="1536" loading="lazy" /><strong>lavanderia ivoti</strong></div><nav class="mobile-nav" aria-label="Navegação móvel"><ul class="mobile-nav-list"><li><a href="#inicio">Início</a></li><li><a href="#servicos">Serviços</a></li><li><a href="#sobre">Sobre</a></li><li><a href="#avaliacoes">Avaliações</a></li><li><a href="#contato">Contato</a></li></ul></nav><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-mobile-whatsapp"><svg class="icon-whatsapp" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/><path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/></svg> Falar no WhatsApp</a></div><div class="mobile-backdrop" data-close-menu></div></div>
  </header>

  <main id="main-content">
    <section class="hero-section" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-crown" aria-hidden="true">✦</div>
          <h1 class="hero-title" id="hero-title">Cuidado profissional<br />para suas peças,<br /><span>em Ivoti.</span></h1>
          <p class="hero-description">Lavagem de roupas, tapetes, estofados e peças especiais com cuidado em Concórdia. Uma lavanderia local para deixar sua rotina mais leve.</p>
          <div class="hero-actions"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-hero-primary"><svg class="icon-whatsapp" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/><path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/></svg><span>Falar no WhatsApp</span></a><a href="#servicos" class="btn btn-hero-secondary"><span>Conhecer serviços</span><span class="arrow">›</span></a></div>
        </div>
        <div class="hero-visual"><img src={asset(site.assets.hero)} alt="Toalhas dobradas com a marca Lavanderia Ivoti" width="1161" height="1354" fetchpriority="high" /></div>
      </div>
      <div class="trust-bar" aria-label="Informações da lavanderia"><div class="trust-item"><span class="trust-symbol gold" aria-hidden="true"><svg viewBox="0 0 44 28" fill="none" aria-hidden="true"><path d="M4 24 9 9l7 8 6-13 6 13 7-8 5 15c0 3-36 3-36 0Z" fill="currentColor"/><circle cx="9" cy="7" r="2" fill="currentColor"/><circle cx="22" cy="2" r="2.4" fill="currentColor"/><circle cx="35" cy="7" r="2" fill="currentColor"/></svg></span><span><strong>Lavanderia Ivoti</strong><small>Cuidado local</small></span></div><div class="trust-item"><span class="trust-symbol" aria-hidden="true"><svg class="icon-location" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C7.58 2 4 5.58 4 10c0 5.75 6.8 11.47 7.42 11.97.35.28.81.28 1.16 0 .62-.5 7.42-6.22 7.42-11.97 0-4.42-3.58-8-8-8zm0 11.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" fill="#EA4335"/><circle cx="12" cy="10" r="3.2" fill="#FFFFFF"/></svg></span><span><strong>Concórdia</strong><small>Ivoti · RS</small></span></div><div class="trust-item"><span class="trust-symbol" aria-hidden="true"><svg class="icon-google" width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.51h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.34z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg></span><span><strong>{site.rating} no Google</strong><small>Opinião de clientes</small></span></div><div class="trust-item"><span class="trust-symbol" aria-hidden="true"><svg class="icon-whatsapp" width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.004 2C6.478 2 1.996 6.482 1.996 12.008c0 1.765.46 3.488 1.332 5.006L2 22l5.127-1.345c1.472.803 3.13 1.227 4.877 1.227 5.526 0 10.008-4.482 10.008-10.008C22.012 6.482 17.53 2 12.004 2z" fill="#25D366"/><path fill-rule="evenodd" clip-rule="evenodd" d="M17.472 14.382c-.301-.15-1.78-.877-2.056-.977-.276-.1-.477-.15-.678.15-.201.3-.777.977-.953 1.177-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.101-.201.05-.376-.025-.526-.075-.15-.678-1.635-.929-2.241-.244-.59-.492-.51-.678-.519l-.578-.01c-.201 0-.527.075-.803.376s-1.054 1.03-1.054 2.512 1.079 2.914 1.23 3.115c.15.201 2.122 3.24 5.141 4.544.718.31 1.278.495 1.716.634.721.23 1.378.197 1.9.12.58-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.352z" fill="#FFFFFF"/></svg></span><span><strong>WhatsApp</strong><small>{site.phoneDisplay}</small></span></div></div>
    </section>

    <section class="services-section" id="servicos" aria-labelledby="services-title"><div class="container"><header class="section-header"><span class="section-eyebrow">NOSSOS SERVIÇOS</span><h2 class="section-title" id="services-title">Soluções completas para o seu dia a dia</h2><div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div></header><div class="services-grid">{services.map((service) => <article class="service-card" id={`servico-${service.id}`}><div class="service-image-wrap"><img src={asset(service.image)} alt={service.title} width="208" height="124" loading="lazy" style={`object-position: ${service.imagePosition}`} /><span class="service-icon" aria-hidden="true"><img src={asset(service.icon)} alt="" width="60" height="60" loading="lazy" /></span></div><div class="service-content"><h3>{service.title}</h3><p>{service.text}</p><a href={whatsapp(service.query)} target="_blank" rel="noopener noreferrer">Saiba mais <span>→</span></a></div></article>)}</div></div></section>

    <section class="about-section" id="sobre" aria-labelledby="about-title"><div class="container about-grid"><div class="about-composite"><div class="heritage-badge"><small>DESDE</small><strong>1962</strong><span class="heritage-crown" aria-hidden="true"><svg viewBox="0 0 54 36" fill="none" aria-hidden="true"><path d="M6 30 12 12l8 10 7-16 7 16 8-10 6 18c0 4-42 4-42 0Z" fill="currentColor"/><circle cx="12" cy="10" r="2.8" fill="currentColor"/><circle cx="27" cy="4" r="3.2" fill="currentColor"/><circle cx="42" cy="10" r="2.8" fill="currentColor"/></svg></span></div><img src={asset(site.assets.about)} alt="Toalhas dobradas representando a qualidade da lavanderia" width="540" height="400" loading="lazy" /></div><div class="about-copy"><span class="about-eyebrow">SOBRE NÓS</span><h2 id="about-title">Tradição, cuidado e confiança que passam de geração em geração.</h2><p>A Lavanderia Ivoti nasceu com um propósito simples e poderoso: cuidar de cada peça como se fosse única.</p><p>Seguimos com o mesmo compromisso de qualidade, investindo em tecnologia, equipe especializada e nos melhores produtos para entregar sempre o melhor para você.</p></div><div class="about-benefits">{aboutBenefits.map((benefit) => <div><img src={asset(benefit.icon)} alt={benefit.alt} class="benefit-icon" width="54" height="54" loading="lazy" /><strong set:html={benefit.title} /></div>)}</div></div></section>

    <section class="institutional-section" id="institucional" aria-labelledby="institutional-title"><div class="container institutional-container"><div class="institutional-content"><div class="institutional-eyebrow-wrap"><span class="institutional-crown" aria-hidden="true"><svg viewBox="0 0 54 36" fill="none" aria-hidden="true"><path d="M6 30 12 12l8 10 7-16 7 16 8-10 6 18c0 4-42 4-42 0Z" fill="currentColor"/><circle cx="12" cy="10" r="2.8" fill="currentColor"/><circle cx="27" cy="4" r="3.2" fill="currentColor"/><circle cx="42" cy="10" r="2.8" fill="currentColor"/></svg></span><span class="institutional-eyebrow">ATENDIMENTO INSTITUCIONAL</span></div><h2 class="institutional-title" id="institutional-title">Rouparia profissional<br />para clínicas e<br /><span>instituições de saúde.</span></h2><p class="institutional-subtitle">Higienização profissional com processos adequados,<br class="hide-mobile" />controle de qualidade e acompanhamento em cada etapa.</p><div class="institutional-differentials"><div class="inst-diff-item"><div class="inst-diff-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg></div><p><span class="inst-line">Processos adequados</span><span class="inst-line">e controle de qualidade</span></p></div><div class="inst-diff-divider" aria-hidden="true"></div><div class="inst-diff-item"><div class="inst-diff-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="2" width="18" height="20" rx="3"/><circle cx="12" cy="13" r="5"/><path d="M12 10a3 3 0 0 1 3 3"/><circle cx="7" cy="6" r="1" fill="currentColor" stroke="none"/><circle cx="10" cy="6" r="1" fill="currentColor" stroke="none"/></svg></div><p><span class="inst-line">Higienização</span><span class="inst-line">profissional e segura</span></p></div><div class="inst-diff-divider" aria-hidden="true"></div><div class="inst-diff-item"><div class="inst-diff-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div><p><span class="inst-line">Comprovação documental</span><span class="inst-line">que atesta nossa aptidão</span></p></div></div><div class="institutional-action-row"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-institutional-cta"><span>Solicitar proposta institucional</span><span aria-hidden="true">›</span></a><div class="institutional-support"><div class="inst-support-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v14"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="10" y1="10" x2="14" y2="10"/></svg></div><p>Atendimento para hospitais, clínicas,<br />laboratórios e centros de diagnóstico.</p></div></div><div class="institutional-bottom-bar" aria-hidden="true"><span class="inst-bar-line"></span><span class="inst-bar-text">TRADIÇÃO QUE CUIDA DE MAIS PESSOAS</span><span class="inst-bar-line inst-bar-long"></span></div></div></div><div class="institutional-visual"><img src={asset(site.assets.institutional)} alt="Rouparia profissional Lavanderia Ivoti" width="1448" height="1086" loading="lazy" /></div></section>

    <section class="process-section" id="como-funciona" aria-labelledby="process-title"><div class="container"><header class="section-header compact"><span class="section-eyebrow">COMO FUNCIONA</span><h2 class="section-title" id="process-title">Prático, rápido e feito para você</h2><div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div></header><div class="process-grid">{processSteps.map((step, index) => <article class="process-step"><span class="step-number">{index + 1}</span><img src={asset(step.icon)} alt={step.alt} class="process-icon" width="92" height="92" loading="lazy" /><div><h3 set:html={step.title} /><p>{step.text}</p></div></article>)}</div></div></section>

    <section class="reviews-section" id="avaliacoes" aria-labelledby="reviews-title"><div class="container"><div class="testimonial-heading"><div><span class="section-eyebrow">AVALIAÇÕES</span><h2 class="section-title" id="reviews-title">A confiança de quem já conhece</h2></div><div><p>Relatos de clientes sobre o cuidado com cada peça.</p><a class="google-rating" href={site.googleProfile} target="_blank" rel="noreferrer" aria-label={`Avaliação ${site.rating} de 5 no Google`}><svg class="google-g" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"></path><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"></path><path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"></path><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"></path></svg><strong>{site.rating}</strong><span class="google-stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>)}</span><small>{reviews.length} avaliações</small></a></div></div><div class="testimonial-grid">{reviews.map((review) => <figure class="testimonial-card"><div class="testimonial-topline"><svg class="google-mark" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"></path><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08-.72-2.45-1.16-4.07-1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"></path><path