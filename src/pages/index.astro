---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutBenefits, faqs, processSteps, reviews, services, site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;
const whatsapp = (subject: string) => `${site.phoneLink}%20Sobre%20${encodeURIComponent(subject)}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.seo.description,
  url: site.seo.url,
  image: `${site.seo.url}${site.seo.ogImage}`,
  telephone: "+5551999199846",
  sameAs: [site.googleProfile, site.instagram],
  address: { "@type": "PostalAddress", streetAddress: "Av. Pres. Lucena, 2084", addressLocality: site.city, addressRegion: site.state, postalCode: site.postalCode, addressCountry: "BR" },
  geo: { "@type": "GeoCoordinates", latitude: -29.6055194, longitude: -51.1627442 },
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.6", bestRating: "5" },
};
---
<BaseLayout>
  <Fragment slot="head">
    <link rel="preload" as="image" href={asset(site.assets.hero)} fetchpriority="high" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
  <header class="site-header" id="siteHeader">
    <div class="container header-container">
      <a href="#inicio" class="header-logo" aria-label="Lavanderia Ivoti - Página inicial">
        <span class="logo-crown" aria-hidden="true">✦</span>
        <span class="logo-copy"><strong>lavanderia</strong><small>ivoti</small></span>
      </a>
      <nav class="site-nav" aria-label="Navegação principal">
        <ul class="nav-list"><li><a href="#inicio" class="nav-link active">Início</a></li><li><a href="#servicos" class="nav-link">Serviços</a></li><li><a href="#sobre" class="nav-link">Sobre</a></li><li><a href="#avaliacoes" class="nav-link">Avaliações</a></li><li><a href="#contato" class="nav-link">Contato</a></li></ul>
      </nav>
      <div class="header-actions"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-header-whatsapp"><span class="wa-dot">◉</span><span>WhatsApp {site.phoneDisplay}</span></a></div>
      <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Abrir menu de navegação" aria-expanded="false" aria-controls="mobileDrawer"><span></span><span></span><span></span></button>
    </div>
    <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true"><div class="mobile-drawer-panel"><button class="mobile-close" type="button" data-close-menu aria-label="Fechar menu">×</button><div class="mobile-drawer-brand"><span class="logo-crown" aria-hidden="true">✦</span><strong>lavanderia ivoti</strong></div><nav class="mobile-nav" aria-label="Navegação móvel"><ul class="mobile-nav-list"><li><a href="#inicio">Início</a></li><li><a href="#servicos">Serviços</a></li><li><a href="#sobre">Sobre</a></li><li><a href="#avaliacoes">Avaliações</a></li><li><a href="#contato">Contato</a></li></ul></nav><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-mobile-whatsapp"><span class="wa-dot">◉</span> Falar no WhatsApp</a></div><div class="mobile-backdrop" data-close-menu></div></div>
  </header>

  <main id="main-content">
    <section class="hero-section" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-crown" aria-hidden="true">✦</div>
          <h1 class="hero-title" id="hero-title">Cuidado profissional<br />para suas peças,<br /><span>em Ivoti.</span></h1>
          <p class="hero-description">Lavagem de roupas, tapetes, estofados e peças especiais com cuidado em Concórdia. Uma lavanderia local para deixar sua rotina mais leve.</p>
          <div class="hero-actions"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-hero-primary"><span class="wa-dot">◉</span><span>Falar no WhatsApp</span></a><a href="#servicos" class="btn btn-hero-secondary"><span>Conhecer serviços</span><span class="arrow">›</span></a></div>
        </div>
        <div class="hero-visual"><img src={asset(site.assets.hero)} alt="Toalhas cuidadosamente dobradas na lavanderia" width="1024" height="768" fetchpriority="high" /></div>
      </div>
      <div class="trust-bar" aria-label="Informações da lavanderia"><div class="trust-item"><span class="trust-symbol gold">✦</span><span><strong>Lavanderia Ivoti</strong><small>Cuidado local</small></span></div><div class="trust-item"><span class="trust-symbol">⌖</span><span><strong>Concórdia</strong><small>Ivoti · RS</small></span></div><div class="trust-item"><span class="trust-symbol">★</span><span><strong>{site.rating} no Google</strong><small>Opinião de clientes</small></span></div><div class="trust-item"><span class="trust-symbol">◉</span><span><strong>WhatsApp</strong><small>{site.phoneDisplay}</small></span></div></div>
    </section>

    <section class="services-section" id="servicos" aria-labelledby="services-title"><div class="container"><header class="section-header"><span class="section-eyebrow">NOSSOS SERVIÇOS</span><h2 class="section-title" id="services-title">Soluções completas para o seu dia a dia</h2><div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div></header><div class="services-grid">{services.map((service) => <article class="service-card" id={`servico-${service.id}`}><div class="service-image-wrap"><img src={asset(service.image)} alt={service.title} width="208" height="124" loading="lazy" style={`object-position: ${service.imagePosition}`} /><span class="service-icon" aria-hidden="true"><img src={asset(service.icon)} alt="" width="60" height="60" loading="lazy" /></span></div><div class="service-content"><h3>{service.title}</h3><p>{service.text}</p><a href={whatsapp(service.query)} target="_blank" rel="noopener noreferrer">Saiba mais <span>→</span></a></div></article>)}</div></div></section>

    <section class="about-section" id="sobre" aria-labelledby="about-title"><div class="container about-grid"><div class="about-composite"><div class="heritage-badge"><small>DESDE</small><strong>1962</strong><span aria-hidden="true">✦</span></div><img src={asset(site.assets.about)} alt="Toalhas dobradas representando a qualidade da lavanderia" width="540" height="400" loading="lazy" /></div><div class="about-copy"><span class="about-eyebrow">SOBRE NÓS</span><h2 id="about-title">Tradição, cuidado e confiança que passam de geração em geração.</h2><p>A Lavanderia Ivoti nasceu com um propósito simples e poderoso: cuidar de cada peça como se fosse única.</p><p>Seguimos com o mesmo compromisso de qualidade, investindo em tecnologia, equipe especializada e nos melhores produtos para entregar sempre o melhor para você.</p></div><div class="about-benefits">{aboutBenefits.map((benefit) => <div><img src={asset(benefit.icon)} alt={benefit.alt} class="benefit-icon" width="54" height="54" loading="lazy" /><strong set:html={benefit.title} /></div>)}</div></div></section>

    <section class="institutional-section" id="institucional" aria-labelledby="institutional-title"><div class="container institutional-container"><div class="institutional-content"><div class="institutional-eyebrow-wrap"><span class="institutional-crown" aria-hidden="true">✦</span><span class="institutional-eyebrow">ATENDIMENTO INSTITUCIONAL</span></div><h2 class="institutional-title" id="institutional-title">Rouparia profissional<br />para clínicas e<br /><span>instituições de saúde.</span></h2><p class="institutional-subtitle">Higienização profissional com processos adequados,<br class="hide-mobile" />controle de qualidade e acompanhamento em cada etapa.</p><div class="institutional-differentials"><div class="inst-diff-item"><div class="inst-diff-icon" aria-hidden="true">✦</div><p><span class="inst-line">Processos adequados</span><span class="inst-line">e controle de qualidade</span></p></div><div class="inst-diff-divider" aria-hidden="true"></div><div class="inst-diff-item"><div class="inst-diff-icon" aria-hidden="true">◌</div><p><span class="inst-line">Higienização</span><span class="inst-line">profissional e segura</span></p></div><div class="inst-diff-divider" aria-hidden="true"></div><div class="inst-diff-item"><div class="inst-diff-icon" aria-hidden="true">✓</div><p><span class="inst-line">Comprovação documental</span><span class="inst-line">que atesta nossa aptidão</span></p></div></div><div class="institutional-action-row"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-institutional-cta"><span>Solicitar proposta institucional</span><span aria-hidden="true">›</span></a><div class="institutional-support"><div class="inst-support-icon" aria-hidden="true">⌖</div><p>Atendimento para hospitais, clínicas,<br />laboratórios e centros de diagnóstico.</p></div></div><div class="institutional-bottom-bar" aria-hidden="true"><span class="inst-bar-line"></span><span class="inst-bar-text">TRADIÇÃO QUE CUIDA DE MAIS PESSOAS</span><span class="inst-bar-line inst-bar-long"></span></div></div></div><div class="institutional-visual" aria-hidden="true"><img src={asset(site.assets.institutional)} alt="Rouparia profissional para clínicas e instituições de saúde" width="494" height="576" loading="lazy" /></div></section>

    <section class="process-section" id="como-funciona" aria-labelledby="process-title"><div class="container"><header class="section-header compact"><span class="section-eyebrow">COMO FUNCIONA</span><h2 class="section-title" id="process-title">Prático, rápido e feito para você</h2><div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div></header><div class="process-grid">{processSteps.map((step, index) => <article class="process-step"><span class="step-number">{index + 1}</span><img src={asset(step.icon)} alt={step.alt} class="process-icon" width="92" height="92" loading="lazy" /><div><h3 set:html={step.title} /><p>{step.text}</p></div></article>)}</div></div></section>

    <section class="reviews-section" id="avaliacoes" aria-labelledby="reviews-title"><div class="container"><header class="section-header compact reviews-header"><span class="section-eyebrow">AVALIAÇÕES</span><h2 class="section-title" id="reviews-title">A confiança de quem já conhece</h2><div class="section-divider" aria-hidden="true"><i></i><span>✦</span><i></i></div></header><div class="reviews-grid">{reviews.map((review) => <article class="review-card"><div class="review-top"><span class="google-mark" aria-hidden="true">G</span><span class="review-stars" aria-label="5 estrelas">★★★★★</span></div><p class="review-text">{review.text}</p><footer class="review-author"><img src={asset(review.avatar)} alt={review.name} class="review-avatar" width="44" height="44" loading="lazy" /><div class="review-author-info"><strong>{review.name}</strong><small>{review.meta}</small></div></footer></article>)}</div></div></section>

    <section class="location-section" id="contato" aria-label="Localização da Lavanderia Ivoti no Google Maps"><iframe src={site.mapsEmbedUrl} loading="lazy" title="Mapa da Lavanderia Ivoti em Concórdia" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe><div class="location-overlay"><div class="location-overlay-inner"><span class="location-pin">⌖</span><div><strong>Lavanderia Ivoti</strong><span>{site.address}</span></div><a href={site.mapsUrl} target="_blank" rel="noreferrer" class="location-route">Abrir rota ↗</a></div></div></section>

    <section class="contact-info-section"><div class="container contact-info-grid"><div><span class="section-eyebrow">FALE COM A EQUIPE</span><h2>Pronto para<br /><span>cuidar melhor?</span></h2></div><div class="contact-info-copy"><p>Av. Pres. Lucena, 2084<br />Concórdia · Ivoti/RS<br />CEP {site.postalCode}</p><div class="contact-buttons"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer" class="btn btn-contact-primary"><span class="wa-dot">◉</span> WhatsApp {site.phoneDisplay}</a><a href={site.googlePhoneLink} class="btn btn-contact-secondary">Telefone {site.googlePhoneDisplay}</a></div><p class="hours-note">Horários de referência: segunda a sexta, 08:30–18:30 · sábado, 08:30–12:00.</p></div></div></section>

    <section class="faq-section" aria-labelledby="faq-title"><div class="container faq-grid"><div><span class="section-eyebrow">DÚVIDAS COMUNS</span><h2 id="faq-title">Quer saber<br /><span>mais?</span></h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div></section>
  </main>

  <footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><a href="#inicio" class="footer-logo" aria-label="Lavanderia Ivoti - início"><span class="logo-crown" aria-hidden="true">✦</span><span class="logo-copy"><strong>lavanderia</strong><small>ivoti</small></span></a><p>Cuidado local para deixar sua rotina mais leve.</p><div class="social-links"><a href={site.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">◎</a><a href={site.googleProfile} target="_blank" rel="noreferrer" aria-label="Google Maps">G</a><a href={site.phoneLink} target="_blank" rel="noreferrer" aria-label="WhatsApp">◉</a></div></div><div class="footer-col"><h3>LINKS RÁPIDOS</h3><ul><li><a href="#inicio">Início</a></li><li><a href="#servicos">Serviços</a></li><li><a href="#sobre">Sobre</a></li><li><a href="#avaliacoes">Avaliações</a></li><li><a href="#contato">Contato</a></li></ul></div><div class="footer-col"><h3>SERVIÇOS</h3><ul>{services.map((service) => <li><a href={`#servico-${service.id}`}>{service.title}</a></li>)}</ul></div><div class="footer-col footer-contact"><h3>CONTATO</h3><p>Av. Pres. Lucena, 2084<br />Concórdia · Ivoti/RS</p><p><a href={site.phoneLink} target="_blank" rel="noreferrer">WhatsApp<br />{site.phoneDisplay}</a></p><p><a href={site.instagram} target="_blank" rel="noreferrer">@lavanderia_ivoti</a></p></div><div class="footer-col footer-hours"><h3>HORÁRIOS</h3><p>Segunda a sexta<br /><strong>08:30–18:30</strong></p><p>Sábado<br /><strong>08:30–12:00</strong></p></div></div><div class="footer-bottom">© {new Date().getFullYear()} Lavanderia Ivoti. Todos os direitos reservados.</div></footer>
  <aside class="mobile-action-bar" aria-label="Contato rápido"><a href={site.phoneLink} target="_blank" rel="noopener noreferrer"><span class="wa-dot">◉</span><span>WhatsApp</span></a><a href={site.mapsUrl} target="_blank" rel="noreferrer"><span>⌖</span><span>Localização</span></a></aside>

  <script is:inline>
    const drawer = document.querySelector('#mobileDrawer');
    const toggle = document.querySelector('#mobileMenuToggle');
    const closeItems = document.querySelectorAll('[data-close-menu], .mobile-nav a');
    const setDrawer = (open) => { if (!drawer || !toggle) return; drawer.classList.toggle('open', open); drawer.setAttribute('aria-hidden', String(!open)); toggle.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-open', open); };
    toggle?.addEventListener('click', () => setDrawer(!drawer?.classList.contains('open')));
    closeItems.forEach((item) => item.addEventListener('click', () => setDrawer(false)));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setDrawer(false); });
  </script>
</BaseLayout>
