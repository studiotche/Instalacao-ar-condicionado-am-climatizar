---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  faqs,
  locations,
  pillars,
  site,
  specialties,
  testimonials,
  whatsappUrl,
} from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\//, "")}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.seo.url.replace(/\/$/, "")}/#person`,
      name: `${site.fullRole} ${site.name}`,
      jobTitle: site.fullRole,
      url: site.seo.url,
      image: `${site.seo.url.replace(/\/$/, "")}${site.seo.ogImage}`,
      telephone: `+${site.phoneLink}`,
      sameAs: [site.googleProfile, site.instagram, site.doctoralia, site.linkedin],
      areaServed: ["Novo Hamburgo"],
      workLocation: locations.slice(0, 1).map((location) => ({
        "@type": "Place",
        name: `Consultório em ${location.city}`,
        address: {
          "@type": "PostalAddress",
          streetAddress: "R. Bento Gonçalves, 2310, Sala 42",
          addressLocality: location.city,
          addressRegion: site.state,
          postalCode: "93510-018",
          addressCountry: "BR",
        },
      })),
    },
    {
      "@type": "Dietitian",
      "@id": `${site.seo.url.replace(/\/$/, "")}/#dietitian`,
      name: `${site.fullRole} ${site.name}`,
      image: `${site.seo.url.replace(/\/$/, "")}${site.seo.ogImage}`,
      telephone: `+${site.phoneLink}`,
      priceRange: "$$",
      medicalSpecialty: "Nutrition",
      sameAs: [site.instagram, site.googleProfile, site.doctoralia, site.linkedin],
      areaServed: ["Novo Hamburgo", "Vale do Sinos"],
      location: locations.slice(0, 1).map((location) => ({
        "@type": "Place",
        name: `Consultório em ${location.city}`,
        address: {
          "@type": "PostalAddress",
          streetAddress: "R. Bento Gonçalves, 2310, Sala 42",
          addressLocality: location.city,
          addressRegion: site.state,
          postalCode: "93510-018",
          addressCountry: "BR",
        },
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${site.seo.url.replace(/\/$/, "")}/#faq`,
      mainEntity: faqs.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
    ...testimonials.map((testimonial) => ({
      "@type": "Review",
      itemReviewed: { "@id": `${site.seo.url.replace(/\/$/, "")}/#dietitian` },
      author: { "@type": "Person", name: testimonial.name },
      ...(testimonial.dateTime ? { datePublished: testimonial.dateTime } : {}),
      reviewBody: testimonial.text,
    })),
  ],
};
---

<BaseLayout>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={asset(site.assets.hero)}
      media="(min-width: 761px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={asset(site.assets.heroMobile)}
      media="(max-width: 760px)"
    />
    <link rel="preload" as="image" href={asset(site.assets.logo)} />
    <link rel="preload" as="image" href={asset("/images/whatsapp.webp")} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#inicio" aria-label={`${site.name}, início`}
        ><img
          src={asset(site.assets.logo)}
          alt={`${site.role} ${site.name}`}
        /></a
      >
      <nav class="desktop-nav" aria-label="Navegação principal">
        <a href="#sobre">Sobre</a><a href="#atendimentos">Atendimentos</a><a
          href="#metodo">Abordagem</a
        ><a href="#depoimentos">Depoimentos</a><a href="#locais">Locais</a>
      </nav>
      <a
        class="button button-small"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer">Agendar consulta</a
      >
      <button
        class="hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="mobileMenu"
        aria-label="Abrir menu"><span></span><span></span><span></span></button
      >
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-backdrop" data-close-menu></div>
    <div class="mobile-menu-panel">
      <button
        class="menu-close"
        type="button"
        data-close-menu
        aria-label="Fechar menu"><span aria-hidden="true">✕</span></button
      >
      <div class="menu-panel-head">
        <span class="menu-brand">Pedro Zvir</span><small class="kicker"
          >Nutricionista Esportivo</small
        >
      </div>
      <nav class="mobile-nav" aria-label="Navegação móvel">
        <a href="#sobre">Sobre</a>
        <a href="#atendimentos">Atendimentos</a>
        <a href="#metodo">Abordagem</a>
        <a href="#depoimentos">Depoimentos</a>
        <a href="#locais">Locais</a>
      </nav>
      <a
        class="button menu-cta"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer">Agendar consulta <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>

  <main id="conteudo">
    <section class="hero" id="inicio">
      <div class="hero-visual">
        <picture class="hero-bg">
          <source
            media="(max-width: 760px)"
            srcset={asset(site.assets.heroMobile)}
          />
          <img
            src={asset(site.assets.hero)}
            alt="Nutricionista Pedro Zvir sorrindo, atendimento particular em Novo Hamburgo"
            width="1920"
            height="946"
            fetchpriority="high"
          />
        </picture>
        <div class="floating-card">
          <span class="floating-kicker">Cuidado individual</span><strong
            >Sem fórmulas prontas.</strong
          >
        </div>
      </div>
      <div class="container hero-copy">
        <p class="eyebrow">{site.hero.eyebrow}</p>
        <h1>
          {site.hero.title.replace(site.hero.titleHighlight, "")}<span
            class="highlight">{site.hero.titleHighlight}</span
          >
        </h1>
        <p class="hero-tagline">{site.hero.tagline}</p>
        <p class="lead">{site.hero.description}</p>
        <div class="hero-actions">
          <a class="button" href={whatsappUrl} target="_blank" rel="noreferrer"
            >Agendar minha consulta <span aria-hidden="true">↗</span></a
          >
          <a class="text-link" href="#atendimentos"
            >Como posso ajudar <span aria-hidden="true">↓</span></a
          >
        </div>
        <div class="location-note">
          <span class="location-dot" aria-hidden="true"></span><span
            >Presencial em Novo Hamburgo · Online</span
          >
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Diferenciais do atendimento">
      <div class="container trust-grid">
        <p><span>01</span> Escuta sem julgamentos</p><p>
          <span>02</span> Estratégias personalizadas
        </p><p><span>03</span> Atendimento particular</p>
      </div>
    </section>

    <section class="section services-section" id="atendimentos">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow eyebrow-light">Posso ajudar você</p><h2>
              Cuidado nutricional para <span class="highlight"
                >diferentes momentos da vida</span
              >
            </h2>
          </div><p>
            Cada acompanhamento começa pela sua história e respeita o
            diagnóstico e os tratamentos conduzidos por outros profissionais.
          </p>
        </div>
        <div class="service-grid">
          {
            specialties.map((specialty) => (
              <article class="service-card">
                <>
                  <span class="service-number">{specialty.number}</span>
                  <div>
                    <>
                      <h3>{specialty.title}</h3>
                      <p>{specialty.text}</p>
                      <p>{specialty.detail}</p>
                    </>
                  </div>
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`Saber mais sobre ${specialty.title.toLowerCase()}`}
                  >
                    Saber mais <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section process-section" id="metodo">
      <img
        class="process-bg"
        src={asset(site.assets.processBg)}
        alt=""
        aria-hidden="true"
        width="1737"
        height="905"
        loading="lazy"
      />
      <div class="container process-grid">
        <div class="process-intro">
          <p class="eyebrow">Abordagem integrada</p><h2>
            Três pilares <span class="highlight">para cuidar</span> de você por inteiro
          </h2><p>
            A alimentação não acontece isolada da vida. Por isso, o
            acompanhamento considera o que você come, como organiza seus hábitos
            e como se relaciona com a comida.
          </p><a
            class="button"
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer"
            >Iniciar meu acompanhamento <span aria-hidden="true">↗</span></a
          >
        </div>
        <ol class="steps-list">
          {
            pillars.map(([title, text], index) => (
              <li>
                <>
                  <span>0{index + 1}</span>
                  <div>
                    <>
                      <h3>{title}</h3>
                      <p>{text}</p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section testimonials-section" id="depoimentos">
      <div class="container">
        <div class="testimonial-heading">
          <div>
            <p class="eyebrow">Transformando vidas</p><h2>
              Experiências de <span class="highlight">quem já começou</span>
            </h2>
          </div>
          <div>
            <p>
              Relatos de pacientes sobre o cuidado recebido durante o
              acompanhamento nutricional.
            </p><a
              class="google-rating"
              href={site.googleProfile}
              target="_blank"
              rel="noreferrer"
              aria-label={`Avaliação ${site.googleRating.score} de 5 em ${site.googleRating.reviews} avaliações no Google`}
            >
              <svg class="google-g" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"
                ></path>
                <path
                  fill="#34A853"
                  d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"
                ></path>
              </svg>
              <strong>{site.googleRating.score}</strong>
              <span class="google-stars" aria-hidden="true">
                {
                  [0, 1, 2, 3, 4].map(() => (
                    <svg viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  ))
                }
              </span>
              <small>{site.googleRating.reviews} avaliações</small>
            </a>
          </div>
        </div>
        <div class="testimonial-grid">
          {
            testimonials.map((testimonial) => (
              <figure class="testimonial-card">
                <>
                  <div class="testimonial-topline">
                    <svg class="google-mark" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"></path>
                      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08-.72-2.45-1.16-4.07-1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"></path>
                      <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"></path>
                      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"></path>
                    </svg>
                    <span class="testimonial-stars" role="img" aria-label="5 estrelas">
                      {
                        [0, 1, 2, 3, 4].map(() => (
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                          </svg>
                        ))
                      }
                    </span>
                  </div>
                  <blockquote>{testimonial.text}</blockquote>
                  <figcaption>
                    <>
                      <span class="testimonial-author">
                        <strong>{testimonial.name}</strong>
                        {testimonial.city && <span>{testimonial.city}</span>}
                        {testimonial.profile ? (
                          <a
                            class="testimonial-source"
                            href={testimonial.profile}
                            target="_blank"
                            rel="noreferrer"
                          >
                            Avalia&#231;&#227;o Google
                          </a>
                        ) : (
                          <span class="testimonial-source">Avalia&#231;&#227;o Google</span>
                        )}
                      </span>
                    </>
                  </figcaption>
                </>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section about-section" id="sobre">
      <div class="container about-grid">
        <div class="about-media">
          <div class="image-frame about-frame">
            <img
              src={asset(site.assets.about)}
              alt="Nutricionista Pedro Zvir em ambiente profissional com luz natural"
              width="704"
              height="1139"
              loading="lazy"
            />
          </div>
          <div class="signature-card" aria-hidden="true">
            <span>PZ</span><small>estratégia que cabe na sua vida</small>
          </div>
        </div>
        <div class="about-copy">
          <p class="eyebrow eyebrow-light">{site.about.eyebrow}</p><h2>
            {site.about.title.replace(site.about.titleHighlight, "")}<span
              class="highlight">{site.about.titleHighlight}</span
            >
          </h2>
          {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p class="about-credentials">{site.credentials}</p>
          <div class="about-values">
            <div>
              <strong>Consciência</strong><span
                >para entender suas escolhas</span
              >
            </div><div>
              <strong>Autonomia</strong><span>para cuidar de si com leveza</span
              >
            </div>
          </div>
          <a
            class="text-link text-link-dark"
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer"
            >Conversar com a nutricionista <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section class="section locations-section" id="locais">
      <div class="container">
        <div class="locations-heading">
          <p class="eyebrow">Onde você pode me encontrar</p><h2>
            Presencial em Novo Hamburgo, com <span class="highlight"
              >a mesma atenção</span
            >
          </h2>
        </div>
        <div class="consultorio-gallery" aria-label="Imagens do consultório em Novo Hamburgo">
          <figure>
            <img
              src={asset(site.assets.consultorio)}
              alt="Consultório de Pedro Zvir em Novo Hamburgo"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <figure>
            <img
              src={asset(site.assets.consultorioNovoHamburgo)}
              alt="Espaço de atendimento do consultório de Pedro Zvir"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
        <div class="locations-grid locations-duo">
          {
            locations.map((location) => (
              <article class="location-card">
                <>
                  <span class="kicker">{location.type}</span>
                  <h3>{location.city}</h3>
                  <p>
                    <>
                      <strong>{location.address}</strong>
                      <small>{location.district}</small>
                    </>
                  </p>
                </>
              </article>
            ))
          }
          <div class="map-frame locations-map">
            <iframe
              src={site.mapsEmbedUrl}
              title="Mapa do consultório da nutricionista Pedro Zvir em Novo Hamburgo"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
        <div class="locations-actions">
          <a
            class="text-link text-link-dark"
            href={site.googleProfile}
            target="_blank"
            rel="noreferrer"
            >Abrir localização no Google <span aria-hidden="true">↗</span></a
          ><p>
            WhatsApp: <a href={whatsappUrl} target="_blank" rel="noreferrer"
              >{site.phoneDisplay}</a
            >
          </p>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="duvidas">
      <div class="container faq-grid">
        <div>
          <p class="eyebrow">Dúvidas frequentes</p><h2>Antes de começar</h2><p
            class="faq-intro"
          >
            Algumas respostas para deixar sua decisão mais tranquila.
          </p>
        </div>
        <div class="faq-list">
          {
            faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <summary>
                  {question}
                  <span aria-hidden="true" />
                </summary>
                <div class="faq-answer">
                  <p>{answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="contact-section" id="contato">
      <div class="container contact-card">
        <div>
          <p class="eyebrow eyebrow-light">Agende sua consulta</p><h2>
            Sua transformação pode começar por <span class="highlight"
              >uma conversa</span
            >
          </h2>
        </div><div class="contact-details">
          <p>
            <span>Modalidade</span><strong>Presencial · Particular</strong>
          </p><p>
            <span>WhatsApp</span><strong>{site.phoneDisplay}</strong>
          </p><a
            class="button button-light"
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer"
            >Falar com Pedro <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <div class="footer-brand logo">
        <img
          src={asset(site.assets.logo)}
          alt={`${site.role} ${site.name}`}
          width="205"
          height="65"
        />
        <p>
          Atendimento nutricional particular<br />
          em Novo Hamburgo, RS.
        </p>
      </div>
      <div class="footer-links">
        <a href={site.telLink}>Ligar: {site.phoneDisplay}</a>
        <div class="social-links" aria-label="Perfis online">
          <a href={site.instagram} target="_blank" rel="noreferrer" aria-label="Instagram" title="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.5 10v8M6.5 6.5v.01M10.5 18v-5a3 3 0 0 1 6 0v5M10.5 10v8"></path>
            </svg>
          </a>
          <a href={site.doctoralia} target="_blank" rel="noreferrer" aria-label="Doctoralia" title="Doctoralia">
            <span class="social-letter" aria-hidden="true">D</span>
          </a>
        </div>
        <a href="#inicio">Voltar ao inicio <span class="back-to-top-arrow" aria-hidden="true">↑</span></a>
      </div>
    </div>
    <div class="container footer-bottom">
      <span
        >© {new Date().getFullYear()}
        {site.name} · {site.fullRole} · {site.crn}</span
      ><span class="footer-credit"
        >Desenvolvido por
        <a href="https://jeankist.com" target="_blank" rel="noreferrer"
          >Jean Kist</a
        >
        ©</span
      >
    </div>
  </footer>
  <a
    class="floating-whatsapp"
    href={whatsappUrl}
    target="_blank"
    rel="noreferrer"
    aria-label="Olá, Pedro! Gostaria de agendar uma consulta."
  >
    <img src={asset("/images/whatsapp.webp")} alt="" width="34" height="34" />
  </a>
</BaseLayout>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>(".hamburger");
  const menu = document.getElementById("mobileMenu");

  if (hamburger && menu) {
    const close = () => {
      menu.classList.remove("open");
      menu.setAttribute("aria-hidden", "true");
      hamburger.setAttribute("aria-expanded", "false");
      document.body.classList.remove("menu-open");
      hamburger.focus();
    };
    const open = () => {
      menu.classList.add("open");
      menu.setAttribute("aria-hidden", "false");
      hamburger.setAttribute("aria-expanded", "true");
      document.body.classList.add("menu-open");
    };

    hamburger.addEventListener("click", () => {
      menu.classList.contains("open") ? close() : open();
    });
    menu
      .querySelectorAll("[data-close-menu]")
      .forEach((el) => el.addEventListener("click", close));
    menu
      .querySelectorAll(".mobile-nav a")
      .forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.classList.contains("open")) close();
    });
  }

  const heroCopy = document.querySelector<HTMLElement>(".hero-copy");

  if (heroCopy) {
    const heroEyebrow = heroCopy.querySelector<HTMLElement>(".eyebrow");
    const heroTitle = heroCopy.querySelector<HTMLElement>("h1");
    const heroTagline = heroCopy.querySelector<HTMLElement>(".hero-tagline");
    const heroLead = heroCopy.querySelector<HTMLElement>(".lead");
    const heroActions = heroCopy.querySelector<HTMLElement>(".hero-actions");
    const heroLocation = heroCopy.querySelector<HTMLElement>(".location-note");
    const heroCard = document.querySelector<HTMLElement>(".floating-card");

    const splitHeroWords = (element: HTMLElement | null) => {
      if (!element) return [];
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      while (walker.nextNode()) textNodes.push(walker.currentNode as Text);

      const words = textNodes.flatMap((node) => {
        const isHighlight = node.parentElement?.closest(".highlight") !== null;
        return (node.textContent || "")
          .trim()
          .split(/\s+/)
          .filter(Boolean)
          .map((text) => ({ text, isHighlight }));
      });

      element.replaceChildren();
      return words.map(({ text, isHighlight }) => {
        const word = document.createElement("span");
        word.className = `hero-reveal-word${isHighlight ? " highlight" : ""}`;
        word.textContent = text;
        element.append(word, " ");
        return word;
      });
    };

    const scheduleHeroWords = (words: HTMLElement[], startDelay: number) => {
      let line = 0;
      let wordInLine = 0;
      let previousTop: number | null = null;

      words.forEach((word) => {
        const currentTop = word.offsetTop;
        if (previousTop !== null && Math.abs(currentTop - previousTop) > 2) {
          line += 1;
          wordInLine = 0;
        }
        word.style.setProperty(
          "--hero-delay",
          `${startDelay + line * 0.1 + wordInLine * 0.025}s`,
        );
        wordInLine += 1;
        previousTop = currentTop;
      });

      return line + 1;
    };

    const startHeroReveal = () => {
      const titleWords = splitHeroWords(heroTitle);
      const taglineWords = splitHeroWords(heroTagline);
      const leadWords = splitHeroWords(heroLead);
      heroCopy.classList.add("hero-reveal-ready");
      heroCard?.classList.add("hero-reveal-ready");

      const eyebrowDelay = 0.06;
      const titleDelay = 0.18;
      const titleLines = scheduleHeroWords(titleWords, titleDelay);
      const taglineDelay = titleDelay + titleLines * 0.1 + 0.32;
      const taglineLines = scheduleHeroWords(taglineWords, taglineDelay);
      const leadDelay = taglineDelay + taglineLines * 0.1 + 0.32;
      const leadLines = scheduleHeroWords(leadWords, leadDelay);
      const actionsDelay = leadDelay + leadLines * 0.1 + 0.32;
      const locationDelay = actionsDelay + 0.38;

      heroEyebrow?.style.setProperty("--hero-delay", `${eyebrowDelay}s`);
      heroActions?.querySelectorAll<HTMLElement>(":scope > *").forEach((item, index) => {
        item.style.setProperty(
          "--hero-delay",
          `${actionsDelay + index * 0.08}s`,
        );
      });
      heroLocation?.style.setProperty("--hero-delay", `${locationDelay}s`);
      heroCard?.style.setProperty("--hero-delay", `${locationDelay}s`);
    };

    if (document.fonts?.ready) {
      document.fonts.ready.then(startHeroReveal);
    } else {
      startHeroReveal();
    }
  }
  const faqItems =
    document.querySelectorAll<HTMLDetailsElement>(".faq-list details");
  const faqTimeouts = new WeakMap<HTMLDetailsElement, number>();
  const FAQ_DURATION = 430;

  const clearFaqTimeout = (details: HTMLDetailsElement) => {
    const timeout = faqTimeouts.get(details);
    if (timeout !== undefined) window.clearTimeout(timeout);
  };

  const finishOpenFaq = (details: HTMLDetailsElement, answer: HTMLElement) => {
    clearFaqTimeout(details);
    faqTimeouts.set(
      details,
      window.setTimeout(() => {
        if (details.open && !details.classList.contains("is-closing")) {
          answer.style.height = "auto";
        }
      }, FAQ_DURATION),
    );
  };

  const animatedCloseFaq = (details: HTMLDetailsElement) => {
    const answer = details.querySelector<HTMLElement>(".faq-answer");
    if (!details.open || !answer || details.classList.contains("is-closing"))
      return;
    details.classList.add("is-closing");
    answer.style.height = `${answer.offsetHeight}px`;
    answer.style.opacity = "1";
    void answer.offsetHeight;
    answer.style.height = "0px";
    answer.style.opacity = "0";
    clearFaqTimeout(details);
    faqTimeouts.set(
      details,
      window.setTimeout(() => {
        details.removeAttribute("open");
        details.classList.remove("is-closing");
        answer.style.height = "";
        answer.style.opacity = "";
      }, FAQ_DURATION),
    );
  };

  const animatedOpenFaq = (details: HTMLDetailsElement) => {
    const answer = details.querySelector<HTMLElement>(".faq-answer");
    if (!answer || details.open) return;
    details.classList.remove("is-closing");
    details.setAttribute("open", "");
    answer.style.height = "0px";
    answer.style.opacity = "0";
    void answer.offsetHeight;
    answer.style.height = `${answer.scrollHeight}px`;
    answer.style.opacity = "1";
    finishOpenFaq(details, answer);
  };

  faqItems.forEach((details) => {
    const summary = details.querySelector("summary");
    if (!summary) return;
    summary.addEventListener("click", (event) => {
      event.preventDefault();
      if (details.classList.contains("is-closing")) {
        clearFaqTimeout(details);
        details.classList.remove("is-closing");
        const answer = details.querySelector<HTMLElement>(".faq-answer");
        if (answer) {
          answer.style.height = `${answer.scrollHeight}px`;
          answer.style.opacity = "1";
          finishOpenFaq(details, answer);
        }
        return;
      }
      if (details.open) {
        animatedCloseFaq(details);
      } else {
        faqItems.forEach((other) => {
          if (other !== details && other.open) animatedCloseFaq(other);
        });
        animatedOpenFaq(details);
      }
    });
  });

  const aboutFrame = document.querySelector(".about-frame");
  if (aboutFrame) {
    if ("IntersectionObserver" in window) {
      const aboutObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              aboutFrame.classList.add("in-view");
              aboutObserver.disconnect();
            }
          });
        },
        { threshold: 0.25 },
      );
      aboutObserver.observe(aboutFrame);
    } else {
      aboutFrame.classList.add("in-view");
    }
  }
</script>
